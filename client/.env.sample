# Copy this file to client/.env and fill in values. Save the file, then restart: npm run dev
#
# Firebase *web* config (Firebase Console → Project settings → Your apps → Web app).
# Must use the VITE_ prefix — Vite only exposes variables that start with VITE_.
# Do NOT put these in server/.env; the backend uses FIREBASE_ACCOUNT_* (service account) instead.

# Backend API (include /api suffix for production)
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase (client SDK — browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
