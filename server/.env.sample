# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/mockmate

# Auth
JWT_SECRET=your_jwt_secret_here
BCRYPT_SALT_ROUNDS=10

# CORS — production frontend URL (dev also allows any localhost port)
FRONTEND_URL=http://localhost:5173

# Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# Optional — defaults to gemini-1.5-flash-latest with automatic fallbacks on 429/404
# GEMINI_MODEL=gemini-1.5-flash-latest

# Firebase Admin SDK (service account JSON — NOT the web app config from the Firebase Console).
# For Google sign-in in the browser, set VITE_FIREBASE_* in client/.env instead.
FIREBASE_ACCOUNT_PROJECT_ID=
FIREBASE_ACCOUNT_CLIENT_EMAIL=
FIREBASE_ACCOUNT_PRIVATE_KEY=
